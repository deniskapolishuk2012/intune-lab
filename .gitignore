# ============================================================
# Intune Lab .gitignore
# ============================================================

# Environment variables — NEVER commit credentials
.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environment
venv/
env/
.venv/

# Logs — exclude real logs, keep structure
logs/*.log

# Intune app packages
*.intunewin
*.msi
*.exe

# Autopilot CSV — contains hardware hash
autopilot.csv

# VS Code
.vscode/

# OS files
.DS_Store
Thumbs.db
